<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CosmonarchyPlusLauncher.ViewModels"
             xmlns:models="using:CosmonarchyPlusLauncher.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
             x:Class="CosmonarchyPlusLauncher.Views.PlayPage"
             x:DataType="vm:PlayViewModel">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <!-- Launcher self-update: the one thing every player should notice. -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="Update Cosmonarchy Launcher" MinWidth="230"
                        Padding="18,10" FontSize="15" FontWeight="SemiBold"
                        Command="{Binding InstallLauncherUpdateCommand}"
                        IsEnabled="{Binding UpdateAvailable}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Latest version:" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LatestVersion}" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateHint}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Check now" Command="{Binding CheckForLauncherUpdateCommand}"
                            IsEnabled="{Binding !UpdateBusy}" />
                    <Button Content="Release page" Command="{Binding OpenLauncherReleaseCommand}"
                            IsVisible="{Binding UpdateAvailable}" />
                    <ProgressBar IsVisible="{Binding UpdateBusy}" Minimum="0" Maximum="100"
                                 Value="{Binding UpdatePercent}"
                                 IsIndeterminate="{Binding UpdateBarIndeterminate}" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Play" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VariantHint}" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,340" Margin="0,8,0,0">

            <!-- Left: installed rows for the selected variant, switchable with
                 one click. Builds and plugins share the list; the badge makes
                 the family unmistakable. -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Row="0" Text="{Binding InstalledHeading}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Installed}"
                         SelectedItem="{Binding SelectedInstall}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstalledEntry">
                            <StackPanel Spacing="2" Margin="0,3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="{Binding BadgeBrush}" CornerRadius="3"
                                            Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="9"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding EmptyHint}" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           MaxWidth="320" TextAlignment="Center"
                           IsVisible="{Binding InstalledEmpty}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Play" MinWidth="110" Command="{Binding PlayCommand}"
                            IsEnabled="{Binding CanPlay}" />
                    <Button Content="Update" MinWidth="110" Command="{Binding UpdateCommand}"
                            IsEnabled="{Binding CanManage}" />
                    <Button Content="Delete" MinWidth="110" Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanManage}" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="{Binding SelectionHint}" Margin="0,6,0,0"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </Grid>

            <!-- Right: install a new build or plugin for the selected variant.
                 Existing checkouts are never touched; every build lands in its
                 own folder. -->
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding InstallHeading}" FontWeight="SemiBold" />
                    <TextBlock Text="Repository" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ComboBox ItemsSource="{Binding Repos}"
                              SelectedItem="{Binding SelectedRepo}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:RepoEntry">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Badge}" FontSize="9"
                                               VerticalAlignment="Center" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Show unofficial mirrors"
                              IsChecked="{Binding ShowUnofficial}"
                              IsVisible="{Binding UnofficialVisible}" />
                    <TextBlock Text="{Binding RepoHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock Text="Version to install" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ComboBox ItemsSource="{Binding NewVersionOptions}"
                              SelectedItem="{Binding SelectedSource}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionOption">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Name (optional)" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBox Text="{Binding NewName}"
                             PlaceholderText="Default: repository + version" />
                    <Button Content="Install" HorizontalAlignment="Stretch"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding CanInstall}" />
                    <TextBlock Text="The install appears in the list on the left immediately; a failed download stays listed so Update can retry it."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4">
            <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Variant:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Variants}"
                              SelectedItem="{Binding SelectedVariant}" MinWidth="150" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0"
                            IsVisible="{Binding RoleVisible}">
                    <TextBlock Text="Role:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding Role}" MinWidth="120" />
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh versions" Margin="14,0,0,0"
                        Command="{Binding RefreshCommand}" />
                <Button Grid.Column="4" Content="Fetch full version log"
                        Command="{Binding UnshallowCommand}"
                        IsEnabled="{Binding CanInstall}" />
            </Grid>
            <TextBlock Text="{Binding RoleWarning}" IsVisible="{Binding RoleWarningVisible}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Margin="0,10,0,0" Padding="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4">
            <StackPanel Spacing="6">
                <ProgressBar IsVisible="{Binding Busy}" Minimum="0" Maximum="100"
                             Value="{Binding DownloadPercent}"
                             IsIndeterminate="{Binding ProgressIndeterminate}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Margin="0,8,0,0" Padding="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4"
                IsVisible="{Binding ShowRemasteredUnlock}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding RemasteredPassword}" PasswordChar="•"
                         PlaceholderText="{Binding RemasteredPromptLabel}" MinWidth="200" />
                <Button Content="{Binding RemasteredUnlockButtonLabel}"
                        Command="{Binding UnlockRemasteredCommand}"
                        MinWidth="90" />
                <TextBlock Text="{Binding RemasteredStatus}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Remastered launch controls (unlocked only): pick the bundle
             channel, see which version is installed and whether the selected
             channel has something newer, then play or download. -->
        <Border Grid.Row="6" Margin="0,8,0,0" Padding="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4"
                IsVisible="{Binding RemasteredVisible}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Remastered" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                          ItemsSource="{Binding RemasteredChannels}"
                          SelectedItem="{Binding RemasteredChannel}"
                          MinWidth="170" FontSize="12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RemasteredChannelOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                           Text="{Binding RemasteredVersionStatus}" TextWrapping="Wrap" />
                <Button Grid.Column="3" Content="Play Remastered" MinWidth="110"
                        Command="{Binding PlayRemasteredCommand}" />
                <Button Grid.Column="4" Margin="8,0,0,0" Content="Download this channel…"
                        MinWidth="150" Command="{Binding PrepareRemasteredDownloadCommand}"
                        IsVisible="{Binding RemasteredDownloadVisible}" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
