<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CosmonarchyPlusLauncher.ViewModels"
             xmlns:models="using:CosmonarchyPlusLauncher.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
             x:Class="CosmonarchyPlusLauncher.Views.ReplaysPage"
             x:DataType="vm:ReplaysViewModel">

    <Grid Margin="16" RowDefinitions="Auto,*">

        <TextBlock Grid.Row="0" Text="Replays" FontSize="20" FontWeight="SemiBold" />

        <TabControl Grid.Row="1" Margin="0,10,0,0">

            <TabItem Header="Cosmonarchy OG">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                        <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshOnlineCommand}" />
                        <TextBox Grid.Column="1" Text="{Binding OgSearch}" PlaceholderText="Search game, player, map, version"
                                 Margin="10,0,0,0" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Players}"
                                  SelectedItem="{Binding OgPlayer}" MinWidth="140" Margin="10,0,0,0" />
                        <TextBox Grid.Column="3" Text="{Binding NewPlayer}" PlaceholderText="Player to follow"
                                 MinWidth="130" Margin="6,0,0,0" />
                        <Button Grid.Column="4" Content="Follow" Command="{Binding FollowPlayerCommand}" Margin="6,0,0,0" />
                        <Button Grid.Column="5" Content="Unfollow" Command="{Binding UnfollowOgCommand}"
                                IsEnabled="{Binding CanUnfollowOg}" Margin="6,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Watch selected" MinWidth="130"
                                Command="{Binding WatchOgCommand}" IsEnabled="{Binding CanWatchOg}" />
                        <Button Content="Download only" MinWidth="120"
                                Command="{Binding DownloadOgCommand}" IsEnabled="{Binding CanWatchOg}" />
                    </StackPanel>

                    <ListBox Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding OgMatches}"
                             SelectedItem="{Binding SelectedOgMatch}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OnlineMatch">
                                <Grid ColumnDefinitions="130,*,150,70,120">
                                    <TextBlock Grid.Column="0" Text="{Binding DateLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PlayersLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MapName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" />
                                    <TextBlock Grid.Column="4" Text="{Binding VersionLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="2">
                        <TextBlock Text="{Binding OgStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OgHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Cosmonarchy Plus">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                        <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshOnlineCommand}" />
                        <TextBox Grid.Column="1" Text="{Binding PlusSearch}" PlaceholderText="Search game, player, map, version"
                                 Margin="10,0,0,0" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Players}"
                                  SelectedItem="{Binding PlusPlayer}" MinWidth="140" Margin="10,0,0,0" />
                        <TextBox Grid.Column="3" Text="{Binding NewPlayer}" PlaceholderText="Player to follow"
                                 MinWidth="130" Margin="6,0,0,0" />
                        <Button Grid.Column="4" Content="Follow" Command="{Binding FollowPlayerCommand}" Margin="6,0,0,0" />
                        <Button Grid.Column="5" Content="Unfollow" Command="{Binding UnfollowPlusCommand}"
                                IsEnabled="{Binding CanUnfollowPlus}" Margin="6,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Watch selected" MinWidth="130"
                                Command="{Binding WatchPlusCommand}" IsEnabled="{Binding CanWatchPlus}" />
                        <Button Content="Download only" MinWidth="120"
                                Command="{Binding DownloadPlusCommand}" IsEnabled="{Binding CanWatchPlus}" />
                    </StackPanel>

                    <ListBox Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding PlusMatches}"
                             SelectedItem="{Binding SelectedPlusMatch}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OnlineMatch">
                                <Grid ColumnDefinitions="130,*,150,70,120">
                                    <TextBlock Grid.Column="0" Text="{Binding DateLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PlayersLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MapName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" />
                                    <TextBlock Grid.Column="4" Text="{Binding VersionLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="2">
                        <TextBlock Text="{Binding PlusStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlusHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Local files">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*">
                        <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}" />
                        <Button Grid.Column="1" Content="Open folder" Command="{Binding OpenFolderCommand}"
                                Margin="10,0,0,0" />
                        <Button Grid.Column="2" Content="Play selected" Command="{Binding PlaySelectedCommand}"
                                IsEnabled="{Binding CanPlay}" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Replays}"
                             SelectedItem="{Binding SelectedReplay}" />

                    <TextBlock Grid.Row="2" Text="Playing a replay switches to the vanilla build (no Plus plugin) and opens the game straight into it."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
