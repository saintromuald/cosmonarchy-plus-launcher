<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CosmonarchyPlusLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
             x:Class="CosmonarchyPlusLauncher.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnDefinitions="140,*" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="Install root" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RootPath}" Watermark="C:\Cosmonarchy\ or the Wine drive_c path" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="140,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="Wine prefix root" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LinuxPrefixRoot}"
                     Watermark="Linux only: ~/Games/cosmonarchy" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="140,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="After pressing Play" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ActionOnPlayOptions}"
                      SelectedItem="{Binding ActionOnPlay}" HorizontalAlignment="Left"
                      MinWidth="180" />
        </Grid>

        <CheckBox Grid.Row="4" Content="Keep the full version log (no shallow history)"
                  IsChecked="{Binding FullVersionLog}" Margin="0,10,0,0" />

        <Grid Grid.Row="5" ColumnDefinitions="140,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="Discord webhook URL" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DiscordWebhookUrl}"
                     Watermark="Optional: Discord → channel → Integrations → Webhooks → New Webhook → Copy URL" />
        </Grid>

        <Grid Grid.Row="6" ColumnDefinitions="140,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="Community repo" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding CommunityRepo}"
                     Watermark="owner/name — the public GitHub repo behind the Community tab" />
        </Grid>

        <Grid Grid.Row="7" ColumnDefinitions="140,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="GitHub token" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding GithubToken}" PasswordChar="•"
                     Watermark="Optional: publish to the community repo (fine-grained, contents write on that repo)" />
        </Grid>

        <Border Grid.Row="8" Margin="0,14,0,0" Padding="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock Text="Remastered access" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding RemasteredPassword}" PasswordChar="•"
                             Watermark="Unlock password" MinWidth="220" />
                    <Button Content="Unlock" Command="{Binding UnlockRemasteredCommand}"
                            MinWidth="100" />
                    <TextBlock Text="{Binding RemasteredStatus}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Channel" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox ItemsSource="{Binding RemasteredChannels}"
                              SelectedItem="{Binding RemasteredChannel}" MinWidth="120"
                              FontSize="12" />
                    <TextBox Text="{Binding RemasteredBundleUrl}" FontSize="12"
                             Watermark="Bundle URL or local path (blank = latest release)" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="100" />
            <Button Content="Restore defaults" Command="{Binding ResetDefaultsCommand}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding !UpdateBusy}" />
            <Button Content="Install update" Command="{Binding InstallUpdateCommand}"
                    IsVisible="{Binding CanInstallUpdate}" IsEnabled="{Binding !UpdateBusy}" />
            <Button Content="Open release page" Command="{Binding OpenReleaseCommand}"
                    IsVisible="{Binding CanOpenRelease}" />
            <StackPanel Spacing="6" VerticalAlignment="Center">
                <ProgressBar IsVisible="{Binding UpdateBusy}" Minimum="0" Maximum="100"
                             Value="{Binding UpdatePercent}"
                             IsIndeterminate="{Binding UpdateBarIndeterminate}" MinWidth="320" />
                <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="11" Text="Linux installs live inside the GE-Proton prefix (~/Games/cosmonarchy); the install root is its drive_c/Cosmonarchy directory. The webhook lets “Post to Discord” send shared notes and lists straight to a channel; sharing also works without it, via the clipboard. The GitHub token is only used to publish and unpublish your own shares on the community board."
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
  </Grid>
</ScrollViewer>

</UserControl>
