<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CosmonarchyPlusLauncher.ViewModels"
        xmlns:views="using:CosmonarchyPlusLauncher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="CosmonarchyPlusLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="900" Height="620"
        MinWidth="720" MinHeight="520">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl>
        <TabItem Header="Play">
            <views:PlayPage />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsPage />
        </TabItem>
        <TabItem Header="Config">
            <views:ConfigPage />
        </TabItem>
        <TabItem Header="Account">
            <views:AccountPage />
        </TabItem>
        <TabItem Header="Statistics">
            <views:StatisticsPage />
        </TabItem>
        <TabItem Header="Statistics Plus">
            <views:StatisticsPlusPage />
        </TabItem>
        <TabItem Header="Replays">
            <views:ReplaysPage />
        </TabItem>
        <TabItem Header="Favourites">
            <views:FavouritesPage />
        </TabItem>
        <TabItem Header="Community">
            <views:CommunityPage />
        </TabItem>
    </TabControl>

</Window>
