<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CosmonarchyPlusLauncher.ViewModels"
             xmlns:core="using:CosmonarchyPlusLauncher.Core.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
             x:Class="CosmonarchyPlusLauncher.Views.CommunityPage"
             x:DataType="vm:CommunityViewModel">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Community" FontSize="20" FontWeight="SemiBold" />

        <TextBlock Grid.Row="1" Text="{Binding WhoAmILabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="1" Content="Open board in browser" Command="{Binding OpenBoardCommand}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Import selected" Command="{Binding ImportSelectedCommand}"
                    Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding BoardLabel}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="0,8,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="90,*,150,130,170" Margin="6,0,0,0">
                <TextBlock Grid.Column="0" Text="Kind" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Name / title" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Shared by" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="When" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Contents" FontWeight="SemiBold" />
            </Grid>

            <ListBox Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding Shares}"
                     SelectedItem="{Binding SelectedShare}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:CommunityShare">
                        <Grid ColumnDefinitions="90,*,150,130,170">
                            <TextBlock Grid.Column="0" Text="{Binding KindLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding AuthorLabel}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding SavedAtLabel}" />
                            <TextBlock Grid.Column="4" Text="{Binding SummaryLabel}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,8,0,0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Unpublish selected (yours)" Command="{Binding UnpublishSelectedCommand}"
                        IsEnabled="{Binding CanUnpublishSelected}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </Grid>

</UserControl>
